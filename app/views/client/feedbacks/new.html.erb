<%= render "shared/workspace_nav" %>
<main class="mx-auto max-w-6xl px-6 py-10 lg:px-10 lg:py-16" data-controller="voice-recorder">
	<%= link_to "← Your feedback", client_dashboard_path, class: "font-mono text-xs uppercase tracking-[.18em] text-[#617069]" %>
	<div class="mt-8 grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start">
		<div>
			<p class="font-mono text-xs uppercase tracking-[.2em] text-[#ef806d]">New signal</p>
			<h1 class="mt-3 text-5xl font-extrabold tracking-[-.05em]">Say it your way.</h1>
			<p class="mt-5 leading-7 text-[#617069]">Write a note, show us the moment, or leave a voice note. A useful signal does not need to fit one format.</p>
			<div class="mt-10 space-y-3 text-sm text-[#617069]"><p><span class="mr-2 text-[#ef806d]">01</span> Add enough context to make it actionable.</p><p><span class="mr-2 text-[#ef806d]">02</span> Attach an image when the detail is visual.</p><p><span class="mr-2 text-[#ef806d]">03</span> Record when speaking is faster than typing.</p></div>
		</div>
		<div class="rounded-[1.75rem] border border-[#1e2825]/10 bg-white/70 p-5 shadow-lg sm:p-8">
			<%= form_with model: [:client, @feedback], class: "space-y-6", html: { multipart: true } do |form| %>
				<div><%= form.label :body, "Write your note", class: "mb-2 block text-sm font-bold" %><%= form.text_area :body, rows: 8, placeholder: "I noticed...", class: "w-full resize-y rounded-2xl border border-[#1e2825]/15 bg-white px-4 py-4 leading-7 outline-none transition placeholder:text-[#95a099] focus:border-[#ef806d] focus:ring-2 focus:ring-[#ef806d]/20" %></div>
				<div class="grid gap-4 sm:grid-cols-2">
					<div class="rounded-2xl border border-dashed border-[#1e2825]/20 bg-[#dfeede]/60 p-5"><div class="flex items-start justify-between gap-3"><div><p class="text-sm font-bold">Add images</p><p class="mt-1 text-xs leading-5 text-[#617069]">Screenshots or photos, up to five.</p></div><span class="text-xl">↗</span></div><%= form.file_field :photos, multiple: true, accept: "image/*", class: "mt-4 block w-full text-xs", data: { "voice-recorder-target": "photos", action: "change->voice-recorder#previewImages" } %><div class="mt-3 flex gap-2" data-voice-recorder-target="gallery"></div></div>
					<div class="rounded-2xl border border-[#ef806d]/30 bg-[#fff2ed] p-5"><div class="flex items-start justify-between gap-3"><div><p class="text-sm font-bold">Leave a voice note</p><p class="mt-1 text-xs leading-5 text-[#8d4035]" data-voice-recorder-target="status">No voice note attached</p></div><span class="text-xl text-[#ef806d]">●</span></div><div class="mt-5 flex items-center gap-3"><button type="button" data-voice-recorder-target="start" data-action="voice-recorder#start" class="rounded-full bg-[#1e2825] px-4 py-2 text-xs font-bold text-white">Start recording</button><button type="button" hidden data-voice-recorder-target="stop" data-action="voice-recorder#stop" class="rounded-full bg-[#ef806d] px-4 py-2 text-xs font-bold text-[#1e2825]">Stop</button><span class="font-mono text-xs" data-voice-recorder-target="timer">00:00</span></div><audio hidden controls class="mt-4 w-full" data-voice-recorder-target="audio"></audio><%= form.file_field :voice_recording, accept: "audio/webm,audio/ogg,audio/mpeg,audio/mp4", hidden: true, data: { "voice-recorder-target": "voiceInput" } %><button type="button" data-action="voice-recorder#removeVoice" class="mt-3 text-xs font-bold text-[#8d4035] underline">Remove voice note</button></div>
				</div>
				<div class="flex items-center justify-between border-t border-[#1e2825]/10 pt-5"><p class="text-xs text-[#7d8982]">Share one medium or combine them.</p><%= form.submit "Send feedback", class: "rounded-xl bg-[#1e2825] px-6 py-3.5 font-bold text-white transition hover:-translate-y-0.5 hover:bg-[#31413a]" %></div>
			<% end %>
		</div>
	</div>
</main>
