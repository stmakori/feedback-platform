<%= render "shared/workspace_nav" %><main class="mx-auto max-w-5xl px-6 py-10 lg:px-10 lg:py-16"><%= link_to "← Your feedback", client_dashboard_path, class: "font-mono text-xs uppercase tracking-[.18em] text-[#617069]" %><div class="mt-8 grid gap-10 lg:grid-cols-[.8fr_1.2fr] lg:items-start"><div><p class="font-mono text-xs uppercase tracking-[.2em] text-[#ef806d]">New signal</p><h1 class="mt-3 text-5xl font-extrabold tracking-[-.05em]">What should we know?</h1><p class="mt-5 leading-7 text-[#617069]">Share the detail that could change the next version. Add an image when it helps tell the story.</p></div><div class="rounded-2xl border border-[#1e2825]/10 bg-white/70 p-7 shadow-lg"><%= form_with model: [:client, @feedback], class: "space-y-5" do |form| %><div><%= form.label :body, "Your note", class: "mb-2 block text-sm font-bold" %><%= form.text_area :body, rows: 9, placeholder: "I noticed...", class: "w-full resize-y rounded-xl border border-[#1e2825]/15 bg-white px-4 py-3.5 outline-none focus:border-[#ef806d]" %></div><div class="rounded-xl border border-dashed border-[#1e2825]/20 bg-[#dfeede]/50 p-5"><%= form.label :photos, "Add images", class: "block text-sm font-bold" %><p class="mt-1 text-xs text-[#617069]">Up to five screenshots or photos.</p><%= form.file_field :photos, multiple: true, accept: "image/*", class: "mt-4 block w-full text-sm" %></div><%= form.submit "Send feedback", class: "w-full rounded-xl bg-[#1e2825] px-5 py-3.5 font-bold text-white" %><% end %></div></div></main>
