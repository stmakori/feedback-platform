<%= render "shared/workspace_nav" %><main class="mx-auto max-w-3xl px-6 py-10 lg:px-10 lg:py-16"><%= link_to "← Your notes", client_feedbacks_path, class: "font-mono text-xs uppercase tracking-[.18em] text-[#617069]" %><article class="mt-8 rounded-2xl border border-[#1e2825]/10 bg-white/70 p-7 shadow-lg sm:p-10"><p class="font-mono text-[10px] uppercase tracking-[.18em] text-[#ef806d]">Your note · <%= @feedback.created_at.strftime("%d %b %Y") %></p><p class="mt-10 whitespace-pre-wrap text-xl leading-9"><%= @feedback.body.presence || "Attachment-only feedback" %></p><% if @feedback.voice_recording.attached? %><div class="mt-10 rounded-2xl bg-[#fff2ed] p-5"><p class="mb-3 text-sm font-bold">Voice note</p><%= render "application/voice_player", recording: @feedback.voice_recording %></div><% end %><% if @feedback.photos.attached? %><div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-3"><% @feedback.photos.each do |photo| %><%= image_tag url_for(photo), class: "aspect-square w-full rounded-xl object-cover", alt: "Feedback image" %><% end %></div><% end %></article></main>
