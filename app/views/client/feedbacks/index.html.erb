<%= render "shared/workspace_nav" %><main class="mx-auto max-w-5xl px-6 py-10 lg:px-10 lg:py-16"><div class="flex items-end justify-between"><div><p class="font-mono text-xs uppercase tracking-[.2em] text-[#ef806d]">Your archive</p><h1 class="mt-3 text-5xl font-extrabold tracking-[-.05em]">Your notes.</h1></div><%= link_to "New note", new_client_feedback_path, class: "rounded-xl bg-[#ef806d] px-4 py-3 text-sm font-extrabold" %></div><div class="mt-10 space-y-3"><% if @feedbacks.any? %><% @feedbacks.each do |feedback| %><%= link_to client_feedback_path(feedback), class: "block rounded-2xl border border-[#1e2825]/10 bg-white/60 p-6 hover:bg-white" do %><div class="flex justify-between gap-4"><p class="line-clamp-2 font-semibold"><%= feedback.body.presence || "Attachment-only feedback" %></p><span class="shrink-0 font-mono text-[10px] text-[#7d8982]"><%= feedback.created_at.strftime("%d %b") %></span></div><% end %><% end %><% else %><div class="rounded-2xl border border-dashed border-[#1e2825]/20 p-14 text-center text-[#617069]">No notes shared yet.</div><% end %></div></main>
