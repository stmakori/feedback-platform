<%= render "shared/workspace_nav" %><main class="mx-auto max-w-6xl px-6 py-10 lg:px-10 lg:py-16"><div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end"><div><p class="font-mono text-xs uppercase tracking-[.2em] text-[#ef806d]">Your private channel</p><h1 class="mt-3 text-5xl font-extrabold tracking-[-.05em]">Make the work better.</h1><p class="mt-3 text-[#617069]">A running place for the thoughts you want your team to hear.</p></div><%= link_to "Share feedback", new_client_feedback_path, class: "rounded-xl bg-[#ef806d] px-5 py-3 text-center font-extrabold text-[#1e2825]" %></div><section class="mt-12 grid gap-4 sm:grid-cols-3"><div class="rounded-2xl bg-[#1e2825] p-6 text-[#f4f1e9]"><p class="font-mono text-[10px] uppercase tracking-[.18em] text-[#9eb3a5]">Your signals</p><p class="mt-5 text-5xl font-extrabold"><%= @feedbacks.count %></p><p class="mt-2 text-sm text-[#9eb3a5]">recently shared</p></div><div class="rounded-2xl border border-[#1e2825]/10 bg-[#dfeede] p-6 sm:col-span-2"><p class="font-mono text-[10px] uppercase tracking-[.18em] text-[#617069]">A good note is specific.</p><p class="mt-5 max-w-lg text-2xl font-extrabold leading-tight">Tell the team what happened, what surprised you, or what would make the next step easier.</p></div></section><section class="mt-14"><div class="flex items-center justify-between"><h2 class="text-2xl font-extrabold">Recent notes</h2><%= link_to "View all", client_feedbacks_path, class: "text-sm font-bold text-[#ef806d]" %></div><% if @feedbacks.any? %><div class="mt-5 space-y-3"><% @feedbacks.each do |feedback| %><%= link_to client_feedback_path(feedback), class: "block rounded-2xl border border-[#1e2825]/10 bg-white/60 p-5 transition hover:-translate-y-0.5 hover:bg-white" do %><p class="line-clamp-2 font-semibold"><%= feedback.body.presence || "Attachment-only feedback" %></p><p class="mt-4 font-mono text-[10px] uppercase tracking-[.16em] text-[#7d8982]"><%= feedback.created_at.strftime("%d %b %Y") %> · private note</p><% end %><% end %></div><% else %><div class="mt-5 rounded-2xl border border-dashed border-[#1e2825]/20 bg-white/40 p-12 text-center"><p class="font-bold">Nothing shared yet.</p><p class="mt-2 text-sm text-[#617069]">Your perspective belongs here.</p></div><% end %></section></main>
