<main class="mx-auto max-w-xl px-6 py-12">
  <h1 class="text-3xl font-bold">Create your workspace</h1>
  <form action="/signup" method="post" class="mt-8 space-y-4">
    <input name="business[name]" value="<%= @business.name %>" placeholder="Business name" required class="w-full rounded border p-3">
    <input type="email" name="business[email]" value="<%= @business.email %>" placeholder="Business email" required class="w-full rounded border p-3">
    <input type="email" name="user[email]" value="<%= @user.email %>" placeholder="Admin email" required class="w-full rounded border p-3">
    <input type="password" name="user[password]" placeholder="Password" required class="w-full rounded border p-3">
    <input type="password" name="user[password_confirmation]" placeholder="Confirm password" required class="w-full rounded border p-3">
    <button type="submit" class="rounded-full bg-[#1e2825] px-5 py-3 font-semibold text-white">Create workspace</button>
  </form>
</main>