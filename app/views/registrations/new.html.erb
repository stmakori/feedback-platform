<main class="min-h-screen bg-[#f4f1e9] px-6 py-8 text-[#1e2825] sm:px-10">
  <nav class="mx-auto flex max-w-7xl items-center justify-between"><%= link_to root_path, class: "font-mono text-xs font-medium uppercase tracking-[.22em]" do %>signal / feedback<% end %><%= link_to "Sign in", new_user_session_path, class: "rounded-full border border-[#1e2825]/20 px-4 py-2 text-sm font-semibold transition hover:bg-[#1e2825] hover:text-white" %></nav>
  <section class="mx-auto grid max-w-6xl gap-12 py-12 lg:grid-cols-[1.05fr_.95fr] lg:items-center lg:py-20">
    <div><p class="font-mono text-xs uppercase tracking-[.22em] text-[#ef806d]">Start listening better</p><h1 class="mt-5 text-5xl font-extrabold leading-[.98] tracking-[-.06em] sm:text-7xl">Build a room for honest feedback.</h1><p class="mt-7 max-w-lg text-lg leading-8 text-[#617069]">Set up your private workspace and give every client a clearer way to be heard.</p><div class="mt-10 grid max-w-md grid-cols-3 gap-3 font-mono text-[10px] uppercase tracking-[.14em] text-[#7d8982]"><span class="border-t border-[#1e2825]/20 pt-3">collect</span><span class="border-t border-[#1e2825]/20 pt-3">notice</span><span class="border-t border-[#1e2825]/20 pt-3">respond</span></div></div>
    <div class="rounded-[2rem] border border-[#1e2825]/10 bg-white/70 p-7 shadow-xl backdrop-blur sm:p-10"><div class="flex items-center justify-between"><span class="font-mono text-[10px] uppercase tracking-[.2em] text-[#ef806d]">New workspace</span><span class="font-mono text-[10px] text-[#7d8982]">01 / 01</span></div><% if @business.errors.any? || @user.errors.any? %><div class="mt-6 rounded-xl border border-[#ef806d]/40 bg-[#ef806d]/10 p-4 text-sm text-[#8d4035]"><%= (@business.errors.full_messages + @user.errors.full_messages).to_sentence %></div><% end %><form action="/signup" method="post" class="mt-8 space-y-4"><input name="business[name]" value="<%= @business.name %>" placeholder="Business name" required class="w-full rounded-xl border border-[#1e2825]/15 bg-white px-4 py-3.5 outline-none transition placeholder:text-[#95a099] focus:border-[#ef806d] focus:ring-2 focus:ring-[#ef806d]/20"><input type="email" name="business[email]" value="<%= @business.email %>" placeholder="Business email" required class="w-full rounded-xl border border-[#1e2825]/15 bg-white px-4 py-3.5 outline-none transition placeholder:text-[#95a099] focus:border-[#ef806d] focus:ring-2 focus:ring-[#ef806d]/20"><div class="my-6 border-t border-[#1e2825]/10"></div><input type="email" name="user[email]" value="<%= @user.email %>" placeholder="Your email" required class="w-full rounded-xl border border-[#1e2825]/15 bg-white px-4 py-3.5 outline-none transition placeholder:text-[#95a099] focus:border-[#ef806d] focus:ring-2 focus:ring-[#ef806d]/20"><input type="password" name="user[password]" placeholder="Create password" required class="w-full rounded-xl border border-[#1e2825]/15 bg-white px-4 py-3.5 outline-none transition placeholder:text-[#95a099] focus:border-[#ef806d] focus:ring-2 focus:ring-[#ef806d]/20"><input type="password" name="user[password_confirmation]" placeholder="Confirm password" required class="w-full rounded-xl border border-[#1e2825]/15 bg-white px-4 py-3.5 outline-none transition placeholder:text-[#95a099] focus:border-[#ef806d] focus:ring-2 focus:ring-[#ef806d]/20"><button type="submit" class="mt-2 w-full rounded-xl bg-[#1e2825] px-5 py-3.5 font-extrabold text-white transition hover:-translate-y-0.5 hover:bg-[#31413a]">Create workspace <span class="ml-2 text-[#ef806d]">→</span></button></form></div>
  </section>
</main>