<header class="border-b border-[#1e2825]/10 bg-[#f4f1e9]/90 backdrop-blur">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-10">
    <%= link_to root_path, class: "font-mono text-xs font-medium uppercase tracking-[.22em]" do %>signal / feedback<% end %>
    <div class="flex items-center gap-3 text-sm font-semibold">
      <% if current_user&.admin? %><%= link_to "Dashboard", admin_dashboard_path, class: "hidden rounded-full px-3 py-2 text-[#617069] hover:bg-white sm:inline" %><%= link_to "Clients", admin_clients_path, class: "hidden rounded-full px-3 py-2 text-[#617069] hover:bg-white sm:inline" %><%= link_to "Feedback", admin_feedbacks_path, class: "hidden rounded-full px-3 py-2 text-[#617069] hover:bg-white sm:inline" %><% elsif current_user&.client? %><%= link_to "My feedback", client_dashboard_path, class: "rounded-full px-3 py-2 text-[#617069] hover:bg-white" %><% end %>
      <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "rounded-full border border-[#1e2825]/15 px-4 py-2 transition hover:bg-[#1e2825] hover:text-white" %>
    </div>
  </nav>
</header>