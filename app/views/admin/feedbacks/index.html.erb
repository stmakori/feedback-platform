<%= render "shared/workspace_nav" %><main class="mx-auto max-w-7xl px-6 py-10 lg:px-10 lg:py-16"><p class="font-mono text-xs uppercase tracking-[.2em] text-[#ef806d]">The signal library</p><h1 class="mt-3 text-5xl font-extrabold tracking-[-.05em]">All feedback.</h1><p class="mt-3 text-[#617069]">Every note, kept close to the work.</p><% if @feedbacks.any? %><div class="mt-10 grid gap-4 md:grid-cols-2"><% @feedbacks.each do |feedback| %><%= link_to admin_feedback_path(feedback), class: "rounded-2xl border border-[#1e2825]/10 bg-white/60 p-6 transition hover:-translate-y-0.5 hover:bg-white" do %><div class="flex items-center justify-between"><span class="font-bold"><%= feedback.client.name %></span><span class="font-mono text-[10px] uppercase tracking-[.14em] text-[#7d8982]"><%= feedback.created_at.strftime("%d %b %Y") %></span></div><p class="mt-6 line-clamp-3 text-lg leading-7"><%= feedback.body.presence || "Attachment-only feedback" %></p><% end %><% end %></div><% else %><div class="mt-10 rounded-2xl border border-dashed border-[#1e2825]/20 bg-white/40 p-14 text-center"><p class="text-xl font-extrabold">No feedback yet.</p><p class="mt-2 text-sm text-[#617069]">Client notes will appear here as they arrive.</p></div><% end %></main>
