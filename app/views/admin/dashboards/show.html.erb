<%= render "shared/workspace_nav" %>
<main class="mx-auto max-w-7xl px-6 py-10 lg:px-10 lg:py-16">
  <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end"><div><p class="font-mono text-xs uppercase tracking-[.22em] text-[#ef806d]">Workspace overview</p><h1 class="mt-3 text-4xl font-extrabold tracking-[-.04em] sm:text-6xl">Good morning, admin.</h1><p class="mt-3 text-[#617069]">Here is what your client conversations are telling you.</p></div><%= link_to "Add a client", new_admin_client_path, class: "rounded-xl bg-[#1e2825] px-5 py-3 text-center font-bold text-white transition hover:-translate-y-0.5" %></div>
  <section class="mt-12 grid gap-4 sm:grid-cols-3"><div class="rounded-2xl bg-[#1e2825] p-6 text-[#f4f1e9]"><p class="font-mono text-[10px] uppercase tracking-[.18em] text-[#9eb3a5]">Total feedback</p><p class="mt-6 text-5xl font-extrabold"><%= @feedback_count %></p><p class="mt-2 text-sm text-[#9eb3a5]">signals collected</p></div><div class="rounded-2xl border border-[#1e2825]/10 bg-white/70 p-6"><p class="font-mono text-[10px] uppercase tracking-[.18em] text-[#ef806d]">Clients</p><p class="mt-6 text-5xl font-extrabold"><%= @clients.count %></p><p class="mt-2 text-sm text-[#617069]">people in your circle</p></div><div class="rounded-2xl border border-[#1e2825]/10 bg-[#dfeede] p-6"><p class="font-mono text-[10px] uppercase tracking-[.18em] text-[#617069]">Next move</p><p class="mt-6 text-2xl font-extrabold">Invite someone new.</p><%= link_to "View clients →", admin_clients_path, class: "mt-4 inline-block text-sm font-bold underline decoration-[#ef806d] decoration-2 underline-offset-4" %></div></section>
  <section class="mt-14"><div class="flex items-center justify-between"><h2 class="text-2xl font-extrabold">Your client circle</h2><%= link_to "See all", admin_clients_path, class: "text-sm font-bold text-[#ef806d]" %></div><% if @clients.any? %><div class="mt-5 grid gap-3 sm:grid-cols-2 lg:grid-cols-3"><% @clients.first(6).each do |client| %><div class="rounded-2xl border border-[#1e2825]/10 bg-white/60 p-5"><div class="flex items-center gap-3"><span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#ef806d]/20 font-bold"><%= client.name.first.upcase %></span><div><p class="font-bold"><%= client.name %></p><p class="text-xs text-[#617069]"><%= client.email %></p></div></div></div><% end %></div><% else %><div class="mt-5 rounded-2xl border border-dashed border-[#1e2825]/20 bg-white/40 p-10 text-center"><p class="font-bold">Your circle is empty.</p><p class="mt-2 text-sm text-[#617069]">Add a client to start collecting useful signals.</p></div><% end %></section>
</main>
