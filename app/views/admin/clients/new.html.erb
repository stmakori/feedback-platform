<main class="mx-auto max-w-xl px-6 py-10"><h1 class="text-3xl font-bold">Add client</h1><%= form_with model: [:admin, @client], class: "mt-8 space-y-4" do |form| %><%= form.text_field :name, placeholder: "Name", required: true, class: "w-full rounded border p-3" %><%= form.email_field :email, placeholder: "Email", required: true, class: "w-full rounded border p-3" %><%= form.telephone_field :phone, placeholder: "Phone", class: "w-full rounded border p-3" %><%= form.submit "Save client", class: "rounded bg-ink px-5 py-3 text-white" %><% end %></main>