<%= render "shared/workspace_nav" %><main class="mx-auto max-w-3xl px-6 py-10 lg:px-10 lg:py-16"><%= link_to "← Clients", admin_clients_path, class: "font-mono text-xs uppercase tracking-[.18em] text-[#617069]" %><div class="mt-8 grid gap-10 lg:grid-cols-[.8fr_1.2fr]"><div><p class="font-mono text-xs uppercase tracking-[.2em] text-[#ef806d]">New relationship</p><h1 class="mt-3 text-5xl font-extrabold tracking-[-.05em]">Add a client.</h1><p class="mt-5 leading-7 text-[#617069]">Keep the person behind the project close. Their invitation will open a private feedback space.</p></div><div class="rounded-2xl border border-[#1e2825]/10 bg-white/70 p-7 shadow-lg"><%= form_with model: [:admin, @client], class: "space-y-5" do |form| %><div><%= form.label :name, "Name", class: "mb-2 block text-sm font-bold" %><%= form.text_field :name, placeholder: "Maya Chen", required: true, class: "w-full rounded-xl border border-[#1e2825]/15 bg-white px-4 py-3.5 outline-none focus:border-[#ef806d]" %></div><div><%= form.label :email, "Email", class: "mb-2 block text-sm font-bold" %><%= form.email_field :email, placeholder: "maya@example.com", required: true, class: "w-full rounded-xl border border-[#1e2825]/15 bg-white px-4 py-3.5 outline-none focus:border-[#ef806d]" %></div><div><%= form.label :phone, "Phone", class: "mb-2 block text-sm font-bold" %><%= form.telephone_field :phone, placeholder: "+1 555 0142", class: "w-full rounded-xl border border-[#1e2825]/15 bg-white px-4 py-3.5 outline-none focus:border-[#ef806d]" %></div><%= form.submit "Save client", class: "w-full rounded-xl bg-[#1e2825] px-5 py-3.5 font-bold text-white" %><% end %></div></div></main>