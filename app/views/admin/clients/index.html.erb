<%= render "shared/workspace_nav" %><main class="mx-auto max-w-7xl px-6 py-10 lg:px-10 lg:py-16"><div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end"><div><p class="font-mono text-xs uppercase tracking-[.2em] text-[#ef806d]">Relationships</p><h1 class="mt-3 text-5xl font-extrabold tracking-[-.05em]">Your clients.</h1><p class="mt-3 text-[#617069]">Invite people into a clearer feedback loop.</p></div><%= link_to "Add client", new_admin_client_path, class: "rounded-xl bg-[#1e2825] px-5 py-3 text-center font-bold text-white" %></div><% if @clients.any? %><div class="mt-10 overflow-hidden rounded-2xl border border-[#1e2825]/10 bg-white/70"><div class="hidden grid-cols-[1fr_1fr_140px] border-b border-[#1e2825]/10 px-6 py-4 font-mono text-[10px] uppercase tracking-[.18em] text-[#7d8982] sm:grid"><span>Client</span><span>Contact</span><span>Status</span></div><ul><% @clients.each do |client| %><li class="grid gap-3 border-b border-[#1e2825]/10 px-6 py-5 last:border-0 sm:grid-cols-[1fr_1fr_140px] sm:items-center"><div class="flex items-center gap-3"><span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#dfeede] font-bold"><%= client.name.first.upcase %></span><span class="font-bold"><%= client.name %></span></div><span class="text-sm text-[#617069]"><%= client.email %><% if client.phone.present? %><br><%= client.phone %><% end %></span><%= button_to client.invitation_pending? ? "Resend invite" : "Invite", invite_admin_client_path(client), method: :post, class: "justify-self-start rounded-full border border-[#ef806d]/50 px-3 py-1.5 text-xs font-bold text-[#8d4035] hover:bg-[#ef806d]/10" %></li><% end %></ul></div><% else %><div class="mt-10 rounded-2xl border border-dashed border-[#1e2825]/20 bg-white/40 p-14 text-center"><p class="text-xl font-extrabold">No clients yet.</p><p class="mt-2 text-sm text-[#617069]">Your first invitation is one thoughtful click away.</p></div><% end %></main>