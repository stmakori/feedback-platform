<main class="mx-auto max-w-5xl px-6 py-10"><div class="flex items-center justify-between"><h1 class="text-3xl font-bold">Clients</h1><%= link_to "Add client", new_admin_client_path, class: "rounded bg-ink px-4 py-2 text-white" %></div><ul class="mt-8 space-y-3"><% @clients.each do |client| %><li class="flex justify-between rounded border p-4"><span><%= client.name %> · <%= client.email %></span><%= button_to "Invite", invite_admin_client_path(client), method: :post, class: "underline" %></li><% end %></ul></main>