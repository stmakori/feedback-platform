<%# Waveform player for a stored voice recording. Enhances a native <audio>
    fallback via the `waveform` Stimulus controller. Usage:
    render "application/voice_player", recording: @feedback.voice_recording
    (lives in app/views/application because app/views/shared is root-owned.) %>
<div data-controller="waveform" data-waveform-url-value="<%= rails_blob_path(recording, disposition: "inline") %>">
  <div hidden data-waveform-target="player">
    <div data-waveform-target="container" class="w-full"></div>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <button type="button" data-waveform-target="play" data-action="waveform#toggle" aria-label="Play"
              class="rounded-full bg-[#1e2825] px-4 py-2 text-xs font-bold text-white transition hover:bg-[#31413a]">Play</button>
      <span class="font-mono text-xs text-[#8d4035]">
        <span data-waveform-target="current">00:00</span> / <span data-waveform-target="duration">00:00</span>
      </span>
      <div class="ml-auto flex items-center gap-1">
        <% [1, 1.25, 1.5, 2].each do |rate| %>
          <button type="button" data-waveform-target="speed" data-rate="<%= rate %>" data-action="waveform#setSpeed"
                  class="rounded-full px-2.5 py-1 text-[11px] font-bold text-[#1e2825] transition">
            <%= rate == rate.to_i ? "#{rate.to_i}×" : "#{rate}×" %>
          </button>
        <% end %>
      </div>
    </div>
  </div>

  <%= audio_tag rails_blob_path(recording, disposition: "inline"), controls: true, preload: "metadata",
        class: "w-full", data: { "waveform-target": "fallback" } %>

  <%= link_to "Download recording", rails_blob_path(recording, disposition: "attachment"),
        class: "mt-3 inline-flex items-center gap-1 text-xs font-bold text-[#8d4035] underline" %>
</div>
