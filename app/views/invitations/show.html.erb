<main class="min-h-screen bg-[#f4f1e9] px-6 py-8 text-[#1e2825] sm:px-10"><nav class="mx-auto max-w-7xl"><%= link_to root_path, class: "font-mono text-xs font-medium uppercase tracking-[.22em]" do %>signal / feedback<% end %></nav><section class="mx-auto grid max-w-5xl gap-12 py-16 lg:grid-cols-[1fr_1fr] lg:items-center lg:py-24"><div><p class="font-mono text-xs uppercase tracking-[.2em] text-[#ef806d]">You are invited</p><h1 class="mt-5 text-5xl font-extrabold leading-[.98] tracking-[-.06em]">Your perspective has a place here.</h1><p class="mt-6 text-lg leading-8 text-[#617069]">Set a password to join the private feedback channel and share what would make the work better.</p></div><div class="rounded-2xl bg-[#1e2825] p-7 text-[#f4f1e9] shadow-2xl sm:p-10"><p class="font-mono text-[10px] uppercase tracking-[.2em] text-[#9eb3a5]">Create your access</p><%= form_with url: invitation_path(token: params[:token]), method: :patch, class: "mt-8 space-y-5" do |form| %><div><%= password_field_tag :password, nil, placeholder: "Create password", required: true, class: "w-full rounded-xl border border-white/15 bg-white/10 px-4 py-3.5 text-white outline-none placeholder:text-[#789083] focus:border-[#ef806d]" %></div><div><%= password_field_tag :password_confirmation, nil, placeholder: "Confirm password", required: true, class: "w-full rounded-xl border border-white/15 bg-white/10 px-4 py-3.5 text-white outline-none placeholder:text-[#789083] focus:border-[#ef806d]" %></div><%= submit_tag "Join workspace", class: "w-full rounded-xl bg-[#ef806d] px-5 py-3.5 font-extrabold text-[#1e2825]" %><% end %></div></section></main>
